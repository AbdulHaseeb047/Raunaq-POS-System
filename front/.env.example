# Development: Vite proxies /api → localhost:3001
VITE_API_URL=/api
VITE_ADMIN_URL=http://localhost:5174

# Production (Vercel) — REQUIRED or sales/search will fail with network / "context" errors:
# Set in Vercel Project → Settings → Environment Variables, then Redeploy.
# Use the full Railway (or other) backend URL — no trailing slash, no /api suffix.
# VITE_API_URL=https://your-backend.up.railway.app
